# =====================================================================
# Lingua Buds translation server -- environment template
# =====================================================================
# Copy to .env and edit. Every variable here maps 1:1 to a field in
# app/config.py. Leave a variable unset to take the documented default;
# defaults are chosen so the server runs on whatever hardware it finds.
#
# WHAT IS MEASURED vs WHAT IS MODELLED
# ------------------------------------
# The latency figures in the comments below are labelled. "MEASURED"
# means this build produced that number on real audio on the machine
# stated. "MODELLED" means it is arithmetic from published hardware
# specs, not an observation. Do not quote a MODELLED number as a result.
# =====================================================================


# ---------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080

# cuda | cpu. Unset = auto-detect via ctranslate2.get_cuda_device_count().
# Set it explicitly in production: if the container loses its GPU mount,
# auto-detect will silently fall back to CPU and serve 10x slower rather
# than failing loudly.
# DEVICE=cuda

LOG_LEVEL=INFO

# Run one inference of each stage at startup so the first real request
# does not pay the lazy-init cost. Turn off only for fast dev restarts.
WARMUP=1


# ---------------------------------------------------------------------
# ASR (faster-whisper / CTranslate2)
# ---------------------------------------------------------------------
# Unset = large-v3-turbo on CUDA, tiny on CPU.
#   large-v3-turbo : 1.51 GB fp16 / 0.75 GB int8   (MODELLED from param count)
#   large-v3       : 2.89 GB fp16
#   tiny           : 75 MB   -- CPU verification only, WER is much worse
# ASR_MODEL=large-v3-turbo

# float16 on CUDA, int8 on CPU when unset. int8_float16 is also valid on
# CUDA and roughly halves weight VRAM at a small accuracy cost.
# ASR_COMPUTE_TYPE=float16

# beam_size=1 is greedy. Higher is more accurate and strictly slower;
# for conversational speech the gain is small and the latency cost is not.
ASR_BEAM_SIZE=1

# Silero VAD. Keep this ON: it is what makes silence cost ~20 ms instead
# of a full decode. MEASURED on this build: silence -> 22.64 ms, and the
# result is flagged hollow=true so that 22 ms is never mistaken for a
# fast transcription.
ASR_VAD_FILTER=1

# 0 = use all cores. CPU only; ignored on CUDA.
ASR_CPU_THREADS=0

# Cross-request batch window for the ASR scheduler.
# Larger batch = more throughput, strictly worse p50. MODELLED trade-off
# on a 3060: B=8 -> 30.6 req/s but p50 392 ms; B=32 -> 44.4 req/s but
# p50 1081 ms. Neither meets 150 ms. Raise these only if you have decided
# throughput matters more than the latency target.
ASR_BATCH_SIZE=8
ASR_BATCH_WAIT_MS=8


# ---------------------------------------------------------------------
# MT (machine translation)
# ---------------------------------------------------------------------
# auto | qwen_vllm | qwen_ct2 | qwen_hf | m2m100_ct2
#   auto        : vLLM+Qwen if importable on CUDA, else a local CT2 model
#   qwen_vllm   : the production GPU path (needs `pip install vllm`)
#   qwen_hf     : portable but slow; debugging only
#   m2m100_ct2  : CTranslate2 M2M100-418M, the CPU verification path
# An explicit value is honoured even if it then fails to load. There is no
# silent downgrade: a server quietly serving a weaker model than you asked
# for is worse than one that refuses to start.
MT_BACKEND=auto

MT_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# fp16 | int8 | int4 | awq | fp8
#
# Why awq (int4) is the default.
#
# WEIGHT SIZES ARE MEASURED, not estimated: the safetensors header of each
# real checkpoint was read over HTTP range requests and the per-tensor byte
# offsets summed. Nothing was downloaded.
#   Qwen/Qwen2.5-1.5B-Instruct       fp16 = 3.087 GB
#   Qwen/Qwen2.5-1.5B-Instruct-AWQ   int4 = 1.615 GB
#
# RETRACTION: an earlier version of this file said int4 was 0.72 GB and
# 16.0 ms. Both were WRONG. That estimate quantised the whole parameter
# count, missing that AWQ leaves the embedding and lm_head matrices in
# fp16 -- 0.467 GB each, 0.934 GB together, MORE than the 0.655 GB of
# quantised linear layers. Worse, config.json says tie_word_embeddings:
# true yet the checkpoint ships lm_head.weight as a separate fp16 tensor,
# so the embeddings are stored TWICE. Trusting the flag instead of reading
# the header is how the wrong figure survived three rounds of arithmetic.
#
# Corrected decode roofline (RTX 3060 = 360 GB/s, MEASURED median of 8
# output tokens per sentence). Decode reads every weight once per token,
# so tok/s <= bandwidth / weight_bytes:
#
#   config                    GB      ceil tok/s   ms@8 ideal   ms@8 real(70%)
#   fp16                    3.087         116.6         68.6            98.0
#   awq int4 (as shipped)   1.614         223.0         35.9            51.2
#   awq int4, tied embeds   1.147         313.9         25.5            36.4
#
# CONCLUSION, stated plainly: the 20-27 ms MT figure is NOT reachable on an
# RTX 3060 with this model at any quantisation. The shipped configuration is
# ~51 ms and the theoretical best case is 36.4 ms. AWQ is still the right
# default -- ~1.9x faster than fp16, 1.47 GB lighter, and ~51 ms leaves room
# inside the 150 ms whole-request budget -- but it must not be sold on a
# number it cannot hit.
#
# IMPORTANT: vLLM's quantization="awq" does NOT quantise at load time; it
# expects weights that are ALREADY AWQ. Pointing it at the unquantised base
# repo fails deep in the weight loader on a missing `qweight` tensor. So the
# server REDIRECTS MT_MODEL to the official -AWQ sibling (verified reachable,
# apache-2.0, ungated) and reports the substitution in /health as
# `model_substitution_note`, with `model_requested` kept alongside `model`.
# A server that reports the model you asked for while serving another is
# worse than one that refuses to start.
MT_QUANT=awq

# Cap on generated tokens. A spoken sentence is ~8-20 tokens; 96 is a
# safety valve against a runaway generation, not a target.
MT_MAX_NEW_TOKENS=96

MT_BATCH_SIZE=16
MT_BATCH_WAIT_MS=5

# Share of VRAM vLLM may claim. Must leave room for Whisper: 0.45 is
# chosen so ASR (~1.5-2.9 GB) and the CUDA context still fit in 12 GB.
# Raise it only if ASR runs on a different device.
MT_GPU_MEM_FRACTION=0.45

# Absolute path to a local CTranslate2 MT model, for the CPU path.
# Unset = auto-discover under ~/convert and ./models.
# MT_CPU_MODEL_PATH=/models/m2m100_418M-ct2-int8


# ---------------------------------------------------------------------
# Admission control  (read this section before changing it)
# ---------------------------------------------------------------------
# The target is <150 ms of server latency. Queueing theory, not opinion:
# if arrival rate x service time >= 1, the queue grows without bound and
# latency diverges -- it does not settle at 150 ms. MEASURED on this build
# at 127.5 ms service time, capacity was 7.8 req/s against 10.0/16.7/33.3
# req/s of offered load, i.e. utilisation rho = 1.28x to 4.25x. Every one
# of those is >= 1.
#
# So the server sheds load with an explicit 503 instead of accepting work
# it cannot finish. That is the difference between a slow server and a
# lying one.
LATENCY_BUDGET_MS=150
ADMISSION_ENABLED=1
REJECT_OVER_BUDGET=1

# Shed when projected_wait > budget * OVERLOAD_FACTOR.
OVERLOAD_FACTOR=1.0

# Hard caps, independent of the latency projection.
MAX_QUEUE_DEPTH=256
MAX_INFLIGHT=512

# IMPORTANT, and learned by MEASUREMENT rather than by design:
# when the device cannot meet the budget even when completely idle (CPU
# here: 1447 ms/item against a 150 ms budget), *any* queue depth >= 1
# projects over budget. The first version of this check therefore
# rejected 46 of 48 requests at peak_queue_depth=1 -- that is not load
# shedding, that is a server that refuses to work.
#
# So when measured service time already exceeds the budget, admission
# switches to queue-GROWTH protection: shed only above this multiple of
# the measured per-item time. /health and /metrics report which mode is
# active in `admission_mode`, and say plainly that the budget is
# unreachable on this hardware.
#
# The multiple is 8.0 and is NOT settable by environment variable. This file
# used to list UNREACHABLE_BUDGET_QUEUE_MULTIPLE=8.0 as if it were a knob; it
# was a phantom -- the value is a Scheduler constructor default and no code
# ever read that name from the environment. Setting it would have changed
# nothing while looking like it should, which is the worst kind of
# documentation error. To change it, edit the default in app/scheduler.py.


# ---------------------------------------------------------------------
# Audio
# ---------------------------------------------------------------------
# Whisper is trained at 16 kHz. Other rates are resampled, not rejected.
SAMPLE_RATE=16000

# Utterances outside this range are rejected before inference rather than
# transcribed into noise.
MIN_UTTERANCE_SECONDS=0.20
MAX_UTTERANCE_SECONDS=30.0


# ---------------------------------------------------------------------
# Metrics
# ---------------------------------------------------------------------
# Rolling window of samples per series. Percentiles are WITHHELD below
# 20 samples (p95) and 100 samples (p99) and return null with a note:
# a "p95" computed from 2 samples is the maximum wearing a label.
METRICS_WINDOW=2048

# ---------------------------------------------------------------------
# Sentence streaming (time-to-first-word)
# ---------------------------------------------------------------------
# Translate an utterance sentence by sentence and send each one as soon as
# it is ready, instead of waiting for the whole utterance. The earbuds can
# start speaking sentence 1 while sentences 2..n are still in flight.
#
# MEASURED on this build (n=5 per mode, identical 5.39 s two-sentence
# utterance, CPU, ASR tiny + m2m100_ct2, client-side wall clock):
#
#   mode        time-to-first-word            total time
#   streaming   1587 ms (range 1499-1604)     2373 ms (range 2250-2415)
#   unified     2228 ms (range 2152-2301)     2228 ms (range 2152-2301)
#   difference  641 ms SOONER                 145 ms SLOWER
#
# READ THE SECOND COLUMN. Streaming does NOT make the server faster. n small
# MT calls carry MORE total overhead than one large call, so the total gets
# slightly worse. The entire gain is in when the first word becomes audible,
# which is why `first_sentence_ms` is its own field and is never folded into
# `total_server_ms`. One number covering both would hide which improved.
#
# The absolute figures above are CPU figures and will shrink on a GPU; the
# ~600 ms saving is proportional to MT time, so treat the RATIO as the
# transferable result, not the milliseconds.
#
# CLIENT CONTRACT: with streaming on, the WebSocket sends one frame per
# sentence ({"type":"sentence", index, is_last, elapsed_ms}) followed by
# exactly one {"type":"final", ...} carrying the unified fields. A client
# written against the old one-frame contract MUST either handle frames or
# send {"stream": false} once per connection -- otherwise it reads sentence 1
# as the finished translation. The `ready` frame announces which mode the
# connection is in, so this is detectable before any audio is sent.
SENTENCE_STREAMING=true

# Minimum length for a piece to count as its own sentence. Shorter pieces are
# merged into their neighbour, because a 3-character fragment costs a whole
# MT call and buys no perceptible head start.
#
# Length is weighted by script, not raw len(): CJK characters count 2.5x.
# Without that, "这是第一句话。" is a COMPLETE sentence in 7 characters, would
# be judged a fragment under a threshold of 12, and would be merged away --
# silently disabling splitting for exactly the languages it must support.
SENTENCE_MIN_CHARS=12

# Hard cap on sentences per utterance. Beyond this the tail is joined into the
# last piece: an utterance split 40 ways spends more time on per-call overhead
# than it saves. No text is ever dropped by the cap; a test asserts that.
SENTENCE_MAX_COUNT=8
